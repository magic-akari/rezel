{
	"indentWidth": 4,
	"lineWidth": 120,
	"newLineKind": "lf",
	"useTabs": true,

	"biome": {},
	"markdown": {},
	"toml": {},
	"yaml": {},

	"excludes": [
		"**/package-lock.json",
		"**/tests/conformance/**",
		"**/tests/upstream/**",
		"alignment/upstream/**/*.json",
		"tools/references/**/snapshots/**/*.json"
	],

	"plugins": [
		"https://plugins.dprint.dev/biome-0.12.10.wasm",
		"https://plugins.dprint.dev/markdown-0.21.1.wasm",
		"https://plugins.dprint.dev/toml-0.7.0.wasm",
		"https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm"
	]
}
