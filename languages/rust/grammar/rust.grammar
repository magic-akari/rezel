@precedence {
  preferGenerics
  try
  implFor
  implBang
  deref
  call
  params
  macroSemi
  macro
  unary
  mult @left
  add @left
  shift @left
  bitAnd @left
  bitXor @left
  bitOr @left
  compare @left
  letChain
  and @left
  or @left
  assign @right
  else @right
  range @left
  cast
  return
  typeArgs
  block
  plusSep
  bound @left
  scope
  crateVis
  selfParam
  mut @cut
  statement
}

@skip { whitespace | LineComment | BlockComment }

@top SourceFile {
  InnerAttribute*
  statement*
}

statement[@isGroup=Statement] {
  declarationStatement |
  AttributeItem |
  AttributeStatement {
    Attribute+ ExpressionStatement {
      blockExpression !statement |
      nonBlockExpression ";"
    }
  } |
  ExpressionStatement {
    blockExpression !statement |
    nonBlockExpression ";"
  }
}

AttributeItem { Attribute+ declarationStatement }

declarationStatement {
  ConstItem {
    Vis? kw<"const"> (BoundIdentifier | kw<"_">) ":" type ("=" expression)? ";"
  } |
  MacroInvocationSemi |
  MacroDefinition {
    macroRulesKeyword "!" Identifier (
      "(" (MacroRule ";")* MacroRule? ")" ";" |
      "{" (MacroRule ";")* MacroRule? "}"
    )
  } |
  DeclarativeMacroItem {
    Vis? kw<"macro"> BoundIdentifier ParenthesizedTokens? BracedTokens
  } |
  EmptyStatement { ";" } |
  ModItem {
    Vis? kw<"mod"> BoundIdentifier (";" | DeclarationList)
  } |
  ForeignModItem {
    kw<"unsafe"> externModifier ForeignDeclarationList
  } |
  StructItem {
    Vis? kw<"struct">
    TypeIdentifier TypeParamList?
    (WhereClause? FieldDeclarationList | OrderedFieldDeclarationList WhereClause? ";" | ";")
  } |
  UnionItem {
    Vis? wkw<"union">
    TypeIdentifier TypeParamList? WhereClause? FieldDeclarationList
  } |
  EnumItem {
    Vis? kw<"enum"> TypeIdentifier TypeParamList? WhereClause?
    EnumVariantList { "{" commaSep<Attribute* EnumVariant> "}" }
  } |
  TypeItem {
    Vis? kw<"type"> TypeIdentifier TypeParamList? WhereClause?
    "=" type WhereClause? ";"
  } |
  FunctionItem {
    Vis? functionFrontMatter functionItemRest
  } |
  ImplItem {
    (
      kw<"const"> kw<"unsafe">? kw<"impl"> TypeParamList? |
      kw<"unsafe">? kw<"impl"> TypeParamList? kw<"const">?
    )
    ((!implBang "!")? type !implFor kw<"for">)? type
    WhereClause? DeclarationList
  } |
  TraitItem {
    Vis? traitHeader TypeIdentifier TypeParamList?
    (
      TraitBounds? WhereClause? DeclarationList |
      "=" plusSep<type | Lifetime | HigherRankedTraitBound | RemovedTraitBound | ConstTraitBound>
      WhereClause? ";"
    )
  } |
  AssociatedType {
    kw<"type"> TypeIdentifier TypeParamList? TraitBounds? WhereClause? ";"
  } |
  LetDeclaration {
    kw<"let"> (!mut kw<"mut">)? pattern (":" type)?
    ("=" Attribute* expression (kw<"else"> Block)?)? ";"
  } |
  UseDeclaration {
    Vis? kw<"use"> useClause ";"
  } |
  ExternCrateDeclaration {
    Vis? kw<"extern"> kw<"crate">
    (
      BoundIdentifier |
      (Identifier | kw<"self">) kw<"as"> (BoundIdentifier | kw<"_">) |
      kw<"self">
    ) ";"
  } |
  StaticItem {
    Vis? kw<"static"> kw<"ref">? kw<"mut">? BoundIdentifier ":" type ("=" expression)? ";"
  }
}

traitHeader {
  kw<"const"> kw<"unsafe">? ckw<"auto">? kw<"trait"> |
  kw<"unsafe">? ckw<"auto">? kw<"trait">
}

functionFrontMatter {
  functionQualifiers? kw<"fn">
}

functionItemRest {
    (BoundIdentifier | Metavariable) TypeParamList? ParamList ("->" type)?
    WhereClause?
    (Block | ";")
}

functionQualifiers {
  ckw<"default"> functionQualifiersAfterDefault? |
  kw<"const"> functionQualifiersAfterConst? |
  kw<"async"> functionQualifiersAfterAsync? |
  kw<"unsafe"> externModifier? |
  externModifier
}

functionQualifiersAfterDefault {
  kw<"const"> functionQualifiersAfterConst? |
  kw<"async"> functionQualifiersAfterAsync? |
  kw<"unsafe"> externModifier? |
  externModifier
}

functionQualifiersAfterConst {
  kw<"async"> functionQualifiersAfterAsync? |
  kw<"unsafe"> externModifier? |
  externModifier
}

functionQualifiersAfterAsync {
  kw<"unsafe"> externModifier? |
  externModifier
}

delimitedTokenTree { ParenthesizedTokens | BracketedTokens | BracedTokens }

MacroRule { tokenTree "=>" delimitedTokenTree }

tokenTree {
  delimitedTokenTree |
  TokenBinding[@dynamicPrecedence=1] {
    Metavariable ~macroBinding ":" tokenIdentifier
  } |
  TokenRepetition {
    "$" "(" tokenTree* ")" separatorToken? ("+" | "*" | "?")
  } |
  MetavariableExpression {
    "$" BracedTokens
  } |
  ArithOp { "*" | "+" } |
  "?" |
  reservedKeyword |
  separatorToken
}

reservedKeyword {
  kw<"abstract"> |
  kw<"become"> |
  kw<"box"> |
  kw<"do"> |
  kw<"final"> |
  kw<"gen"> |
  kw<"macro"> |
  kw<"override"> |
  kw<"priv"> |
  kw<"try"> |
  kw<"typeof"> |
  kw<"unsized"> |
  kw<"virtual"> |
  kw<"yield">
}

separatorToken {
  String |
  RawString |
  Char |
  Integer |
  Float |
  tokenIdentifier |
  Lifetime |
  Metavariable ~macroBinding |
  ArithOp { "-" | "/" | "%" } |
  BitOp { "<<" | ">>" | "&" | "|" | "^" } |
  LogicOp { "||" | "&&" } |
  UpdateOp | CompareOp |
  "." | "," | ";" | ":" | "=" | "->" | "=>" | ".." | "..=" | "..." | "::" |
  "<-" | "#" | "!" | "@" | "~"
}

ParenthesizedTokens { "(" tokenTree* ")" }
BracketedTokens { "[" tokenTree* "]" }
BracedTokens { "{" tokenTree* "}" }

Attribute {
  "#" "[" MetaItem "]"
}

InnerAttribute {
  "#" "!" "[" MetaItem "]"
}

MetaItem {
  path ("=" expression | delimitedTokenTree)? |
  UnsafeAttribute { kw<"unsafe"> ParenthesizedTokens }
}

DeclarationList {
  "{" InnerAttribute* (declarationStatement | AttributeItem)* "}"
}

ForeignDeclarationList[@name=DeclarationList] {
  "{" InnerAttribute* (Attribute* foreignDeclaration)* "}"
}

foreignDeclaration {
  MacroInvocationSemi |
  FunctionItem {
    Vis? (wkw<"safe"> | kw<"unsafe">)? kw<"fn">
    BoundIdentifier TypeParamList? ForeignParamList ("->" type)?
    WhereClause? ";"
  } |
  StaticItem {
    Vis? (wkw<"safe"> | kw<"unsafe">)? kw<"static"> kw<"mut">?
    BoundIdentifier ":" type ";"
  } |
  ForeignTypeItem {
    Vis? kw<"type"> TypeIdentifier ";"
  }
}

ForeignParamList[@name=ParamList] {
  "(" commaSep<Attribute* (ForeignParameter | ForeignVariadicParameter)> ")"
}

ForeignParameter[@name=Parameter] {
  (BoundIdentifier | kw<"_">) ":" type
}

ForeignVariadicParameter[@name=VariadicParameter] {
  (BoundIdentifier ":")? "..."
}

EnumVariant {
  Vis? Identifier (FieldDeclarationList | OrderedFieldDeclarationList)? ("=" expression)?
}

FieldDeclarationList {
  "{" commaSep<Attribute* FieldDeclaration> "}"
}

FieldDeclaration {
  Vis? FieldIdentifier ":" type
}

OrderedFieldDeclarationList {
  "(" commaSep<Attribute* Vis? type> ")"
}

WhereClause {
  kw<"where"> commaSep<LifetimeClause | TypeBoundClause>
}

LifetimeClause { Lifetime ":" plusSep<Lifetime> }

TypeBoundClause { (HigherRankedTraitBound | type) TraitBounds }

TraitBounds {
  ":" plusSep<type | Lifetime | HigherRankedTraitBound | RemovedTraitBound | ConstTraitBound>
}

HigherRankedTraitBound {
  kw<"for"> TypeParamList type
}

RemovedTraitBound {
  "?" traitBound
}

ConstTraitBound {
  ("[" kw<"const"> "]" | "~" kw<"const"> | kw<"const">) traitBound
}

traitBound {
  TypePath |
  GenericType |
  FunctionType |
  HigherRankedTraitBound |
  ParenthesizedTraitBound
}

ParenthesizedTraitBound { "(" traitBound ")" }

typeParam[@inline] {
  Lifetime |
  Metavariable |
  TypeIdentifier ~path |
  ConstrainedTypeParameter |
  OptionalTypeParameter |
  ConstParameter
}

TypeParamList {
  tpOpen !preferGenerics
  (Attribute* typeParam !preferGenerics ("," (Attribute* typeParam)? !preferGenerics)*)?
  tpClose
}

ConstParameter {
  kw<"const"> BoundIdentifier ":" type ("=" constArgument)?
}

constArgument {
  Block |
  kw<"const"> Block |
  InferredConst |
  literal |
  ArithOp { "-" } (Integer | Float) |
  pathIdent<Identifier> ~path
}

InferredConst { kw<"_"> }

ConstrainedTypeParameter {
  (Lifetime | TypeIdentifier) TraitBounds
}

OptionalTypeParameter {
  (TypeIdentifier | ConstrainedTypeParameter) "=" type
}

useClause {
  pathIdent<BoundIdentifier> |
  ScopedIdentifier { simplePathPrefix BoundIdentifier } |
  UseAsClause { simplePath kw<"as"> (BoundIdentifier | kw<"_">) } |
  UseList |
  ScopedUseList { simplePathPrefix UseList } |
  UseWildcard { simplePathPrefix? "*" }
}

UseList {
  "{" commaSep<useClause> "}"
}

ParamList {
  "(" commaSep<Attribute* (Parameter | SelfParameter | VariadicParameter { "..." } | kw<"_">)> ")"
}

SelfParameter {
  "&"? Lifetime? (!mut kw<"mut">)? !selfParam kw<"self">
}

Parameter {
  (!mut kw<"mut">)? pattern ":" type
}

externModifier {
  kw<"extern"> String?
}

Vis {
  kw<"pub"> (!call "(" (kw<"self"> | kw<"super"> | kw<"crate"> | kw<"in"> path) ")")? |
  kw<"crate"> !crateVis
}

type[@isGroup=Type] {
  AbstractType { kw<"impl"> (traitBound | ConstTraitBound) } |
  InferredType { kw<"_"> } |
  ReferenceType { ("&" | "&&") Lifetime? kw<"mut">? type } |
  PointerType { "*" (kw<"const"> | kw<"mut">) type } |
  TypePath |
  GenericType |
  TupleType { "(" commaSep1<type> ")" } |
  UnitType { "(" ")" } |
  ArrayType { "[" type (";" expression)? "]" } |
  FunctionType |
  MacroInvocation { TypePath !macro "!" delimitedTokenTree } |
  EmptyType { "!" } |
  DynamicType { kw<"dyn"> (traitBound | ConstTraitBound) } |
  BoundedType {
    Lifetime !bound "+" type |
    type !bound "+" (type | Lifetime | UseBound | ConstTraitBound | RemovedTraitBound)
  }
}

UseBound {
  kw<"use"> !typeArgs tpOpen commaSep<Lifetime | Identifier> tpClose
}

FunctionType {
  ForLifetimes { kw<"for"> tpOpen commaSep<Lifetime> tpClose }?
  (
    TypePath !params FunctionTraitParamList |
    kw<"unsafe">? externModifier? kw<"fn"> !params BareFunctionParamList
  )
  ("->" type)?
}

FunctionTraitParamList[@name=ParamList] {
  "(" commaSep<type> ")"
}

BareFunctionParamList[@name=ParamList] {
  "(" commaSep<Attribute* (BareFunctionParameter | BareFunctionVariadicParameter)> ")"
}

BareFunctionParameter[@name=Parameter] {
  (BoundIdentifier | kw<"_">) ":" type |
  type
}

BareFunctionVariadicParameter[@name=VariadicParameter] {
  ((BoundIdentifier | kw<"_">) ":")? "..."
}

GenericType {
  TypePath !typeArgs TypeArgList
}

TypeArgList {
  tpOpen
  commaSep1<type | TypeBinding | Lifetime | literal | NegativeConstArgument | Block>
  tpClose
}

NegativeConstArgument { ArithOp { "-" } (Integer | Float) }

TypeBinding {
  (TypeIdentifier | GenericType) ("=" type | TraitBounds)
}

expression[@isGroup=Expression] { blockExpression | nonBlockExpression }

nonBlockExpression {
  UnaryExpression { (ArithOp { "-" } | DerefOp { "*" } | LogicOp { "!" }) !unary expression } |
  ReferenceExpression {
    ("&" | "&&") (kw<"mut"> | wkw<"raw"> (kw<"const"> | kw<"mut">))? expression
  } |
  TryExpression { expression !try "?" } |
  BinaryExpression |
  UnderscoreAssignmentExpression[@name=AssignmentExpression] {
    kw<"_"> !assign "=" expression
  } |
  AssignmentExpression { expression !assign ("=" | UpdateOp) expression } |
  TypeCastExpression { expression !cast kw<"as"> type } |
  ReturnExpression { kw<"return"> (!return expression)? } |
  RangeExpression { expression? !range (".." | "..." | "..=") expression? } |
  CallExpression { expression !call ArgList } |
  literal |
  path ~path |
  AwaitExpression { expression !deref "." kw<"await"> } |
  FieldExpression |
  GenericFunction { (path | FieldExpression) !scope "::" TypeArgList } |
  BreakExpression { kw<"break"> LoopLabel? (!return expression)? } |
  ContinueExpression { kw<"continue"> LoopLabel? } |
  IndexExpression { expression !deref "[" expression "]" } |
  ArrayExpression {
    "[" InnerAttribute*
    (
      Attribute* expression ";" (expression | InferredConst) |
      commaSep1<Attribute* expression>
    )?
    "]"
  } |
  TupleExpression { "(" InnerAttribute* expression ("," expression?)+ ")" } |
  MacroInvocation { macroInvocation } |
  UnitExpression { "(" ")" } |
  ClosureExpression {
    kw<"async">? kw<"move">? ClosureParamList
    (("->" type)? !statement Block | expression)
  } |
  ParenthesizedExpression { "(" InnerAttribute* expression ")" } |
  StructExpression { structName ~path ("::" TypeArgList)? FieldInitializerList }
}

FieldExpression { expression !deref "." (FieldIdentifier | Integer) }

blockExpression {
  UnsafeBlock { kw<"unsafe"> Block } |
  AsyncBlock { kw<"async"> kw<"move">? Block } |
  ConstBlock { kw<"const"> Block } |
  TryBlock { kw<"try"> Block } |
  LabeledBlock { LoopLabel ":" Block } |
  Block |
  IfExpression |
  MatchExpression {
   kw<"match"> expression MatchBlock { "{" InnerAttribute* (MatchArm<",">* MatchArm<","?>)? "}" }
  } |
  WhileExpression {
    (LoopLabel ":")? kw<"while"> cond Block
  } |
  LoopExpression {
    (LoopLabel ":")? kw<"loop"> Block
  } |
  ForExpression {
    (LoopLabel ":")? kw<"for"> pattern kw<"in"> expression Block
  }
}

macroInvocation {
  path !macro "!" delimitedTokenTree
}

MacroInvocationSemi[@name=MacroInvocation] {
  path !macro "!" ((ParenthesizedTokens | BracketedTokens) !macroSemi ";" | BracedTokens !macroSemi)
}

QualifiedScope { tpOpen type (kw<"as"> type)? tpClose }

pathIdent<and> {
  kw<"self"> |
  Metavariable |
  kw<"super"> |
  kw<"crate"> |
  and
}

pathSegment {
  pathIdent<ScopeIdentifier> ~path !scope "::" (TypeArgList "::")?
}

path {
  pathIdent<Identifier> ~path |
  ScopedIdentifier {
    (path | QualifiedScope | genericPathPrefix)? !scope "::" pathIdent<Identifier> ~path
  }
}

genericPathPrefix {
  path !scope "::" TypeArgList
}

TypePath {
  pathIdent<Identifier> ~path |
  (TypePath | QualifiedScope | genericTypePathPrefix)? !scope "::" pathIdent<Identifier> ~path
}

genericTypePathPrefix {
  TypePath (!scope "::")? TypeArgList
}

simplePathPrefix[@inline] {
  "::" (pathIdent<ScopeIdentifier> ~path !scope "::")* |
  (pathIdent<ScopeIdentifier> ~path !scope "::")+
}

simplePath {
  pathIdent<Identifier> ~path |
  ScopedIdentifier { simplePathPrefix pathIdent<Identifier> ~path }
}

structName {
  path ~path
}

patternPath {
  MetaPattern { Metavariable ~path } |
  BoundIdentifier ~path |
  SelfPattern { kw<"self"> ~path } |
  ScopedIdentifier {
    (("::" | QualifiedScope !scope "::") pathSegment* | pathSegment+) pathIdent<Identifier> ~path
  }
}

BinaryExpression {
  expression !add ArithOp { "+" | "-" } expression |
  expression !mult ArithOp { "*" | "/" | "%" } expression |
  expression !shift BitOp { "<<" | ">>" } expression |
  expression !bitAnd BitOp { "&" } expression |
  expression !bitXor BitOp { "^" } expression |
  expression !bitOr BitOp { "|" } expression |
  expression !compare CompareOp expression |
  expression !and AndOp expression |
  expression !or OrOp expression
}

AndOp[@name=LogicOp] { "&&" }

OrOp[@name=LogicOp] { "||" }

ArgList {
  "(" commaSep<Attribute* expression> ")"
}

FieldInitializerList {
  "{" commaSep<fieldInitializer> "}"
}

fieldInitializer {
  ShorthandFieldInitializer { Attribute* Identifier } |
  FieldInitializer { Attribute* (FieldIdentifier | Integer) ":" expression } |
  BaseFieldInitializer { ".." expression }
}

IfExpression {
  kw<"if"> cond Block (!else kw<"else"> (Block | IfExpression))?
}

cond {
  LetChain |
  expression
}

LetChain {
  LetCondition (!letChain "&&" letChainOperand)* |
  expression !letChain "&&" LetCondition
  (!letChain "&&" letChainOperand)*
}

letChainOperand[@inline] { LetCondition | expression !letChain }

LetCondition { kw<"let"> pattern "=" expression !letChain }

Guard { kw<"if"> cond }

MatchArm<after> {
  Attribute* pattern Guard?
  "=>" (nonBlockExpression after | !block blockExpression ","?)
}

ClosureParamList[@name=ParamList] {
  closureParamDelim commaSep<Parameter { (!mut kw<"mut">)? pattern (":" type)?}> closureParamDelim
}

Block {
  "{"
  InnerAttribute*
  statement*
  ExpressionStatement { Attribute* expression }?
  "}"
}

pattern[@isGroup=Pattern] {
  LiteralPattern { literalPattern } |
  patternPath |
  TuplePattern { structName? "(" commaSep<pattern> ")" } |
  StructPattern {
    structName
    FieldPatternList { "{" commaSep<FieldPattern | ".."> "}" }
  } |
  RefPattern { kw<"ref"> !unary pattern } |
  SlicePattern { "[" commaSep<pattern> "]" } |
  CapturedPattern { BoundIdentifier "@" pattern } |
  ReferencePattern { ("&" | "&&") !unary (!mut kw<"mut">)? pattern } |
  ".." |
  MutPattern { kw<"mut"> !unary pattern } |
  RangePattern {
    (literalPattern | path) (".." | "..." | "..=") (literalPattern | path) |
    (".." | "..." | "..=") (literalPattern | path)
  } |
  OrPattern { pattern !or "|" pattern } |
  MacroPattern { macroInvocation } |
  kw<"_">
}

FieldPattern {
  kw<"ref">? (!mut kw<"mut">)? (BoundIdentifier | FieldIdentifier ":" pattern)
}

literal {
  String |
  RawString |
  Char |
  boolean |
  Integer |
  Float
}

literalPattern {
  literal |
  ArithOp { "-" } (Integer | Float)
}

boolean { @specialize[@name=Boolean]<identifier, "true" | "false"> }

@skip {} {
  BlockComment[isolate] { "/*" (BlockComment | blockCommentContent)* blockCommentEnd }

  String[isolate] { stringStart (Escape | stringContent)* stringEnd }
}

Identifier { identifier }

TypeIdentifier[@dynamicPrecedence=1] { identifier }

FieldIdentifier { identifier }

ScopeIdentifier { identifier }

BoundIdentifier { identifier }

LoopLabel { quoteIdentifier }

Lifetime { quoteIdentifier }

kw<term> { @specialize[@name={term}]<identifier, term> }

wkw<term> { @extend[@name={term}]<identifier, term> }

ckw<term> { @extend[@name={term}]<identifier, term> }

commaSep<expr> { commaSep1<expr>? }

commaSep1<expr> { expr ("," expr?)* }

plusSep<expr> { expr (!plusSep "+" expr)* }

@external tokens closureParam from "./tokens" { closureParamDelim[@name="|"] }

@external tokens tpDelim from "./tokens" { tpOpen[@name="<"], tpClose[@name=">"] }

@external tokens literalTokens from "./tokens" { RawString[isolate], Float }

@external tokens rustMacroRules from "./identifier" { macroRulesKeyword[@name="macro_rules"] }

@external tokens rustTokenIdentifiers from "./identifier" { tokenIdentifier[@name=Identifier] }

@external tokens rustIdentifiers from "./identifier" { identifier }

@external tokens rustLifetimes from "./identifier" { quoteIdentifier }

@external tokens rustMetavariables from "./identifier" { Metavariable }

@tokens {
  whitespace { $[\t-\r \u{0085}\u{200e}\u{200f}\u{2028}\u{2029}] }

  UpdateOp { ($[+\-*/%^&|] | "<<" | ">>") "=" }

  CompareOp { $[<>] "="? | $[!=] "=" }

  Integer {
    ($[0-9] $[0-9_]* |
     "0x" $[0-9a-fA-F_]+ |
     "0b" $[01_]+ |
     "0o" $[0-7_]+)
    (("u" | "i") ("8" | "16" | "32" | "64" | "128" | "size"))?
  }

  hex { $[0-9a-fA-F] }
  Escape { "\\" (![xu] | "u" hex hex hex hex | "u{" hex+ "}" | "x" hex hex) }

  Char { "b"? "'" (Escape | ![\\'])? "'" }

  LineComment[isolate] { "//" ![\n]* }

  @precedence { LineComment, "/" }

  blockCommentContent { ![*/] blockCommentContent? | "*" blockCommentStar | "/" blockCommentSlash }
  blockCommentStar { ![/*] blockCommentContent | "*" blockCommentStar }
  blockCommentSlash { ![/*] blockCommentContent | "/" blockCommentSlash }

  blockCommentEnd { ![*/] blockCommentEnd | "*" blockCommentEndStar | "/" blockCommentEndSlash }
  blockCommentEndStar { "/" | ![/*] blockCommentEnd | "*" blockCommentEndStar }
  blockCommentEndSlash { ![/*] blockCommentEnd | "/" blockCommentEndSlash }

  @precedence { blockCommentEnd, blockCommentContent }

  stringStart { ("b" | "c")? '"' }
  stringContent { !["\\\n]* "\n" | !["\\\n]+ }
  stringEnd { '"' }

  "[" "]" "{" "}" "(" ")"
  ";" ":" "::" ","
  "=" "->" "=>" ".." "..."
  "&" "!"
}

@external propSource rustHighlighting from "./highlight"

@detectDelim
